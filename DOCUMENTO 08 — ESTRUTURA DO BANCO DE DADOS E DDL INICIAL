# 16. Tabela ITEM_CONFERENCIA

```sql
CREATE TABLE item_conferencia (
    id_item_conferencia UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    id_conferencia UUID NOT NULL,

    id_item_documento UUID NOT NULL,

    id_material UUID NOT NULL,

    quantidade_esperada NUMERIC(15,3) NOT NULL,

    quantidade_recebida NUMERIC(15,3) NOT NULL DEFAULT 0,

    diferenca NUMERIC(15,3)
        GENERATED ALWAYS AS
        (quantidade_recebida - quantidade_esperada)
        STORED,

    status VARCHAR(30) NOT NULL DEFAULT 'PENDENTE',

    identificado_em TIMESTAMPTZ,

    conferido_em TIMESTAMPTZ,

    CONSTRAINT fk_item_conferencia_conferencia
        FOREIGN KEY (id_conferencia)
        REFERENCES conferencia(id_conferencia),

    CONSTRAINT fk_item_conferencia_item_documento
        FOREIGN KEY (id_item_documento)
        REFERENCES item_documento(id_item_documento),

    CONSTRAINT fk_item_conferencia_material
        FOREIGN KEY (id_material)
        REFERENCES material(id_material),

    CONSTRAINT ck_item_conferencia_quantidade_esperada
        CHECK (quantidade_esperada >= 0),

    CONSTRAINT ck_item_conferencia_quantidade_recebida
        CHECK (quantidade_recebida >= 0)
);
```

